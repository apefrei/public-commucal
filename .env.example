# Copy to .env and fill in. Never commit .env.

# Database passwords. Use URL-safe values, they are placed into connection URLs (generate: openssl rand -hex 24)
# Owner/superuser, used only by the migrate container and tests
POSTGRES_PASSWORD=
# Runtime roles (ADR-0004): web, worker, mcp; auth is used only by Better Auth in web (ADR-0003)
DB_APP_PASSWORD=
DB_WORKER_PASSWORD=
DB_MCP_PASSWORD=
DB_AUTH_PASSWORD=

# Better Auth (ADR-0003): signs cookies and encrypts TOTP secrets and backup codes. At least 32 characters
# (generate: openssl rand -hex 32). Changing it invalidates all sessions and every user's MFA.
BETTER_AUTH_SECRET=
# Public origin of the web app, e.g. https://commucal.ch; staging on cyberfrog: https://192.168.119.131:8443
PUBLIC_URL=https://localhost:8443

# Host name or IP for HTTPS via Caddy (profile "local"), e.g. 192.168.119.131 on cyberfrog
COMMUCAL_HOST=localhost
# Address and port Caddy listens on; staging on cyberfrog: PROXY_BIND=192.168.119.131
PROXY_BIND=127.0.0.1
PROXY_PORT=8443

# Direct ports of web and mcp (production: only 127.0.0.1, the host nginx proxies them)
WEB_BIND=127.0.0.1
WEB_PORT=3000
MCP_BIND=127.0.0.1
MCP_PORT=3001

# Email (ADR-0006). Production: RESEND_API_KEY (Resend, region eu-west-1, domain commucal.ch verified).
# Development and staging: MAILPIT_URL=http://mailpit:8025 (profile local). The worker refuses to start without one.
MAIL_FROM="CommuCal <noreply@commucal.ch>"
RESEND_API_KEY=
MAILPIT_URL=http://mailpit:8025
# Mailpit web UI (profile local). It shows every email, including reset links: keep it on a trusted network.
MAILPIT_BIND=127.0.0.1
MAILPIT_PORT=8025

# GitHub token for the GitHub MCP server used by Claude Code (.mcp.json); fine-grained, only the needed repos
GITHUB_TOKEN=

# First global admin (FR-8), created at start if it does not exist. No password here: the account receives a link
# by email to set it, then sets up MFA at the first login. Alternative: docker compose run --rm admin (prompts).
GLOBAL_ADMIN_EMAIL=
GLOBAL_ADMIN_NAME=
