{
  "name": "@commucal/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing/test-database.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:custom": "drizzle-kit generate --custom",
    "migrate": "node src/migrate.ts",
    "seed": "node src/seed.ts"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.6",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commucal/config": "workspace:*",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.5"
  }
}
